# Copy to .env (gitignored) and fill in. Never commit .env.

# The number people text to reach Warden: Akul's phone. Messages on the Mac
# running the bot must be signed into this Apple ID.
WARDEN_AGENT_HANDLE=

# Testing phones that text Warden (comma-separated). Always answered.
# Not part of the demo or the submission.
WARDEN_TESTER_HANDLES=

# test   = answer only the tester handles above
# public = also answer strangers (judges), but only when they send an address,
#          link or the word "warden", so Akul's regular texts are left alone
WARDEN_MODE=test

# Agent (agent.py) uses Claude to word replies. Without a key it falls back to the
# Auditor's own messages and cannot answer follow-ups.
ANTHROPIC_API_KEY=

# Live Auditor base URL from Akul (GET <url>/screen?address=..&chainId=..).
# Empty = the shared fixtures in fixtures/auditor-output/.
WARDEN_AUDITOR_URL=

# Transfers: only tester handles can confirm a send, capped at this amount.
# WARDEN_TRANSFER=module:function  # send(to, amount_eth) -> tx hash, from the Agent workstream
# Unset = demo mode: the gate and YES step run, but no transaction is sent.
WARDEN_MAX_SEND_ETH=0.01
